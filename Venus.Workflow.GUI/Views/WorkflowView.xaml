<UserControl x:Class="Venus.Workflow.GUI.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Venus.Workflow.GUI.Views"
             xmlns:converters="clr-namespace:Venus.Workflow.GUI.Converters"
             xmlns:nodes="clr-namespace:Venus.Workflow.Core.Nodes;assembly=Venus.Workflow.Core"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#f0f2f5">

    <UserControl.Resources>
        <!-- 转换器 -->
        <local:NodesConverter x:Key="NodesConverter" />
        <local:StateToBrushConverter x:Key="StateToBrushConverter" />
        <local:NodeTypeToIconColorConverter x:Key="NodeTypeToIconColorConverter" />
        <converters:NodeTypeToIconConverter x:Key="NodeTypeToIconConverter" />
        <converters:NodeIsGroupNodeConverter x:Key="NodeIsGroupNodeConverter" />
        
        <!-- 状态颜色画刷 -->
        <SolidColorBrush x:Key="IdleBrush" Color="#808080" />
        <SolidColorBrush x:Key="RunningBrush" Color="#2196f3" />
        <SolidColorBrush x:Key="WaitingBrush" Color="#ffc107" />
        <SolidColorBrush x:Key="CancelBrush" Color="#9c27b0" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#f44336" />
        <SolidColorBrush x:Key="SkipBrush" Color="#9e9e9e" />
        <SolidColorBrush x:Key="CompleteBrush" Color="#4caf50" />

        <!-- 状态背景画刷 -->
        <SolidColorBrush x:Key="IdleBgBrush" Color="#f5f5f5" />
        <SolidColorBrush x:Key="RunningBgBrush" Color="#e3f2fd" />
        <SolidColorBrush x:Key="WaitingBgBrush" Color="#fff8e1" />
        <SolidColorBrush x:Key="CancelBgBrush" Color="#f3e5f5" />
        <SolidColorBrush x:Key="ErrorBgBrush" Color="#ffebee" />
        <SolidColorBrush x:Key="SkipBgBrush" Color="#fafafa" />
        <SolidColorBrush x:Key="CompleteBgBrush" Color="#e8f5e9" />

        <!-- 状态标签文字颜色 -->
        <SolidColorBrush x:Key="IdleTextBrush" Color="#616161" />
        <SolidColorBrush x:Key="RunningTextBrush" Color="#1565c0" />
        <SolidColorBrush x:Key="WaitingTextBrush" Color="#f57f17" />
        <SolidColorBrush x:Key="CancelTextBrush" Color="#7b1fa2" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#c62828" />
        <SolidColorBrush x:Key="SkipTextBrush" Color="#757575" />
        <SolidColorBrush x:Key="CompleteTextBrush" Color="#2e7d32" />

        <!-- 状态标签文字 -->
        <local:StateToTextConverter x:Key="StateToTextConverter" />

        <!-- 卡片阴影效果 -->
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="1" BlurRadius="8" Opacity="0.12" Color="#000000"/>
        <DropShadowEffect x:Key="CardShadowHover" ShadowDepth="2" BlurRadius="12" Opacity="0.2" Color="#000000"/>

        <!-- 节点卡片内容模板 -->
        <DataTemplate x:Key="NodeContentTemplate">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧状态指示条 -->
                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,12,2">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource StateToBrushConverter}" ConverterParameter="Indicator">
                            <Binding Path="State" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：图标 + 名称 + 耗时 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 节点类型图标 -->
                        <Path Grid.Column="0"
                              Data="{Binding Converter={StaticResource NodeTypeToIconConverter}}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Fill="{Binding Converter={StaticResource NodeTypeToIconColorConverter}}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>

                        <!-- 节点名称 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#1a1a2e"
                                   VerticalAlignment="Center"/>

                        <!-- 执行耗时 -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ExecutionTime, StringFormat='⏱ {0}ms'}"
                                   FontSize="11"
                                   Foreground="#8898aa"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 第二行：描述 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Description}"
                               FontSize="12"
                               Foreground="#6c757d"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 第三行：消息 -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding Message}"
                               FontSize="12"
                               Foreground="#495057"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               MaxHeight="40"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 第四行：状态标签 -->
                    <Border Grid.Row="3"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Padding="8,3"
                            CornerRadius="12">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource StateToBrushConverter}" ConverterParameter="TagBackground">
                                <Binding Path="State" />
                            </MultiBinding>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                             <!-- 状态圆点 -->
                             <Ellipse Width="8" Height="8"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center">
                                 <Ellipse.Fill>
                                     <MultiBinding Converter="{StaticResource StateToBrushConverter}" ConverterParameter="TagDot">
                                         <Binding Path="State" />
                                     </MultiBinding>
                                 </Ellipse.Fill>
                                 <Ellipse.Style>
                                     <Style TargetType="Ellipse">
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding State}" Value="Running">
                                                 <DataTrigger.EnterActions>
                                                     <BeginStoryboard>
                                                         <Storyboard RepeatBehavior="Forever">
                                                             <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                            From="8" To="12" Duration="0:0:0.8"
                                                                            AutoReverse="True"/>
                                                             <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                            From="8" To="12" Duration="0:0:0.8"
                                                                            AutoReverse="True"/>
                                                             <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                            From="1" To="0.3" Duration="0:0:0.8"
                                                                            AutoReverse="True"/>
                                                         </Storyboard>
                                                     </BeginStoryboard>
                                                 </DataTrigger.EnterActions>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Ellipse.Style>
                             </Ellipse>

                            <!-- 状态文字 -->
                            <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}"
                                       FontSize="11"
                                       FontWeight="Medium">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource StateToBrushConverter}" ConverterParameter="TagText">
                                        <Binding Path="State" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>

                            <!-- 异常信息 -->
                            <TextBlock Text="{Binding Exception.Message}" FontSize="12" Foreground="Red" Margin="10 0 0 0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 展开/折叠按钮样式 -->
        <Style x:Key="TreeViewExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <Path x:Name="Arrow"
                          Data="M 4,6 L 10,12 L 4,18"
                          Stroke="#6c757d"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem 样式 - 卡片外观 -->
        <Style TargetType="TreeViewItem" x:Key="NodeTreeViewItemStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 卡片主体 -->
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 展开/折叠按钮（仅 GroupNode 显示） -->
                                    <ToggleButton Grid.Column="0"
                                                  x:Name="Expander"
                                                  Visibility="{Binding Converter={StaticResource NodeIsGroupNodeConverter}}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource TreeViewExpanderStyle}"/>

                                    <!-- 内容 -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <!-- 子节点容器 -->
                            <ItemsPresenter Grid.Row="1"
                                            x:Name="ItemsHost"
                                            Margin="24,8,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <!-- 状态颜色 -->
                            <DataTrigger Binding="{Binding State}" Value="Idle">
                                <Setter Property="Background" Value="{StaticResource IdleBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Running">
                                <Setter Property="Background" Value="{StaticResource RunningBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Waiting">
                                <Setter Property="Background" Value="{StaticResource WaitingBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Cancel">
                                <Setter Property="Background" Value="{StaticResource CancelBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource ErrorBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Skip">
                                <Setter Property="Background" Value="{StaticResource SkipBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Complete">
                                <Setter Property="Background" Value="{StaticResource CompleteBgBrush}"/>
                            </DataTrigger>

                            <!-- 选中状态 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1565c0"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <!-- 悬停效果 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardShadowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
    </UserControl.Resources>

    <Grid>
        <TreeView x:Name="NodeTreeView"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemsSource>
                <MultiBinding Converter="{StaticResource NodesConverter}">
                    <Binding Path="Nodes" />
                    <Binding Path="FinalizeNode" />
                </MultiBinding>
            </TreeView.ItemsSource>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type nodes:FlowNode}"
                                          ItemsSource="{Binding Nodes}">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource NodeContentTemplate}"/>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style BasedOn="{StaticResource NodeTreeViewItemStyle}" TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="False"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
