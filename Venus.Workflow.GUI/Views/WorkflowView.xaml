<UserControl x:Class="Venus.Workflow.GUI.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Venus.Workflow.GUI.Views"
             xmlns:nodes="clr-namespace:Venus.Workflow.Core.Nodes;assembly=Venus.Workflow.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Geometry x:Key="ArrowGeometry">M689.9712 512h215.7568a34.133333 34.133333 0 0 1 24.1664 58.2656L559.342933 940.782933a68.266667 68.266667 0 0 1-96.529066 0L92.296533 570.2656A34.133333 34.133333 0 0 1 116.394667 512h215.722666V103.185067a68.266667 68.266667 0 0 1 68.266667-68.266667h221.2864a68.266667 68.266667 0 0 1 68.266667 68.266667V512z</Geometry>

        <local:NodesConverter x:Key="NodesConverter" />
        <DataTemplate x:Key="FlowNodeTemplate">
            <Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" />
                    <Border Grid.Row="2">
                        <Grid>
                            <TextBlock Text="{Binding Message}" />
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="ListBoxItem" x:Key="NodeItemStyle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" x:Name="Bd" BorderThickness="2"  Padding="5">
                                <ContentPresenter />
                            </Border>

                            <Grid Grid.Row="1" Margin="0 10 0 0">
                                <Path Data="{StaticResource ArrowGeometry}" Fill="#808080" 
                                      Stretch="Fill"
                                      Width="20" 
                                      Height="30" HorizontalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Idle">
                                <Setter Property="BorderBrush" Value="#808080" />
                                <Setter Property="Background" Value="#40808080" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Running">
                                <Setter Property="BorderBrush" Value="#2196f3" />
                                <Setter Property="Background" Value="#402196f3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Waiting">
                                <Setter Property="BorderBrush" Value="#ffc107" />
                                <Setter Property="Background" Value="#40ffc107" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Cancel">
                                <Setter Property="BorderBrush" Value="#9c27b0" />
                                <Setter Property="Background" Value="#409c27b0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Error">
                                <Setter Property="BorderBrush" Value="#f44336" />
                                <Setter Property="Background" Value="#40f44336" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Skip">
                                <Setter Property="BorderBrush" Value="#9e9e9e" />
                                <Setter Property="Background" Value="#409e9e9e" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Complete">
                                <Setter Property="BorderBrush" Value="#4caf50" />
                                <Setter Property="Background" Value="#404caf50" />
                            </DataTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="Navy" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--节点列表-->
        <ListBox ItemTemplate="{StaticResource FlowNodeTemplate}" 
                 ItemContainerStyle="{StaticResource NodeItemStyle}" 
                 x:Name="NodeListBox">
            <ListBox.ItemsSource>
                <MultiBinding Converter="{StaticResource NodesConverter}">
                    <Binding Path="Nodes" />
                    <Binding Path="FinalizeNode.Nodes" />
                </MultiBinding>
            </ListBox.ItemsSource>
        </ListBox>
    </Grid>
</UserControl>
